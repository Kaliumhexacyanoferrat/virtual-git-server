<Project>

    <PropertyGroup>

        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>

        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>

        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>

        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>
        <Version>0.1.0</Version>

        <Authors>Andreas Nägeli</Authors>
        <Copyright>Copyright © Andreas Nägeli</Copyright>

        <PackageProjectUrl>https://kaliumhexacyanoferrat.github.io/virtual-git-server/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Kaliumhexacyanoferrat/virtual-git-server</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>

        <!-- files generated during the build are not in the repository, so source link cannot point to them -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>CS1591,CS1572,CS1573</NoWarn>

    </PropertyGroup>

    <ItemGroup>

        <None Include="$(MSBuildThisFileDirectory)Resources\icon.png" Pack="true" PackagePath="\" Visible="false" />

    </ItemGroup>

    <ItemGroup>

        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />

    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <Title>GenHTTP Virtual Git Server</Title>
        <Description>Serves virtual git repositories from a GenHTTP handler. Clones, fetches and pushes are answered from your own data model via the smart HTTP protocol - without a repository on disk and without the git binary.</Description>
        <PackageTags>GenHTTP HTTP Webserver C# Module Git Server Smart-HTTP Virtual Repository Clone Fetch Push Versioning</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

    </PropertyGroup>

    <ItemGroup>

        <PackageReference Include="GenHTTP.Api" Version="11.0.5" />

    </ItemGroup>

    <ItemGroup>

        <InternalsVisibleTo Include="GenHTTP.Modules.Git.Tests" />

    </ItemGroup>

    <ItemGroup>

        <None Include="README.md" Pack="true" PackagePath="" />

    </ItemGroup>

</Project>

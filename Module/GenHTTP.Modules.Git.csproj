<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <Description>Serves virtual git repositories over smart HTTP from a GenHTTP handler. Clones, fetches and pushes are answered from your own data model - no repository on disk, no git binary.</Description>
        <PackageTags>GenHTTP HTTP Webserver C# Module Git Smart-HTTP Server Virtual Repository Clone Push</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

    </PropertyGroup>

    <ItemGroup>

        <PackageReference Include="GenHTTP.Api" Version="11.0.5" />

    </ItemGroup>

    <ItemGroup>

        <InternalsVisibleTo Include="GenHTTP.Modules.Git.Tests" />

    </ItemGroup>

    <ItemGroup>

        <None Include="README.md" Pack="true" PackagePath="" />

    </ItemGroup>

</Project>
